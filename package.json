{
  "name": "pi-rex-subagents",
  "version": "0.0.0",
  "description": "Rex-backed delegated Pi sessions",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "harness": "node harness/run.ts",
    "models": "python3 -B models/run.py 20000 && python3 -B models/vacuity.py 5000 && python3 -B models/protocol.py"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typebox": "^1.4.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
