{
  "name": "pi-rex-subagents",
  "version": "0.1.0",
  "description": "Delegate work to fresh Pi sessions in Rex tabs: parallel, background and nested subagents with checkout-aware admission",
  "keywords": [
    "agents",
    "pi",
    "pi-package",
    "rex",
    "subagents"
  ],
  "homepage": "https://github.com/mattpjohnston/pi-rex-subagents#readme",
  "bugs": "https://github.com/mattpjohnston/pi-rex-subagents/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattpjohnston/pi-rex-subagents.git"
  },
  "files": [
    "src",
    "rex",
    "docs/design.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "harness": "node harness/run.ts",
    "models": "python3 -B models/run.py 20000 && python3 -B models/vacuity.py 5000 && python3 -B models/protocol.py"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typebox": "^1.4.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
